From 12bcd285f89d5c46e9efc7de845825a5ae4445f8 Mon Sep 17 00:00:00 2001
From: James <james@localhost>
Date: Sat, 7 Nov 2026 13:36:53 -0300
Subject: [PATCH 2/3] sake: Use armv8-2a for 2nd arch

Project Infinity X's build/make lists cortex-a76 as an ARMv8.2-A core
and rejects armv8-a. Snapdragon 888 cores are all ARMv8.2-A.
---
 BoardConfig.mk | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/BoardConfig.mk b/BoardConfig.mk
index a7b0c4a..8434212 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -39,7 +39,7 @@ TARGET_CPU_ABI := arm64-v8a
 TARGET_CPU_VARIANT := cortex-a76
 
 TARGET_2ND_ARCH := arm
-TARGET_2ND_ARCH_VARIANT := armv8-a
+TARGET_2ND_ARCH_VARIANT := armv8-2a
 TARGET_2ND_CPU_ABI := armeabi-v7a
 TARGET_2ND_CPU_ABI2 := armeabi
 TARGET_2ND_CPU_VARIANT := cortex-a76
