From 0b1475e484203ee9cea24fc648d0bd00709a48bd Mon Sep 17 00:00:00 2001
From: James <james@localhost>
Date: Sat, 7 Nov 2026 13:36:53 -0300
Subject: [PATCH 1/3] sake: Bring up Project Infinity X

- Rename lineage_sake.mk to infinity_sake.mk and inherit vendor/infinity
- Vanilla build (WITH_GAPPS := false), UDFPS enabled
- Add Infinity X "About phone" properties
---
 AndroidProducts.mk                  |  2 +-
 BoardConfig.mk                      |  2 +-
 lineage_sake.mk => infinity_sake.mk | 17 ++++++++++++++---
 3 files changed, 16 insertions(+), 5 deletions(-)
 rename lineage_sake.mk => infinity_sake.mk (64%)

diff --git a/AndroidProducts.mk b/AndroidProducts.mk
index e4ddebf..a1e3f11 100644
--- a/AndroidProducts.mk
+++ b/AndroidProducts.mk
@@ -5,4 +5,4 @@
 #
 
 PRODUCT_MAKEFILES := \
-    $(LOCAL_DIR)/lineage_sake.mk
+    $(LOCAL_DIR)/infinity_sake.mk
diff --git a/BoardConfig.mk b/BoardConfig.mk
index ea96a9b..a7b0c4a 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -124,7 +124,7 @@ TARGET_KERNEL_CONFIG := vendor/$(PRODUCT_DEVICE)_defconfig
 TARGET_KERNEL_SOURCE := kernel/asus/sm8350
 
 # Partitions
--include vendor/lineage/config/BoardConfigReservedSize.mk
+-include vendor/infinity/config/BoardConfigReservedSize.mk
 BOARD_ASUS_DYNAMIC_PARTITIONS_PARTITION_LIST := odm product system system_ext vendor vendor_dlkm
 BOARD_ASUS_DYNAMIC_PARTITIONS_SIZE := 7512192768 # BOARD_SUPER_PARTITION_SIZE - 4MB
 BOARD_BUILD_SUPER_IMAGE_BY_DEFAULT := true
diff --git a/lineage_sake.mk b/infinity_sake.mk
similarity index 64%
rename from lineage_sake.mk
rename to infinity_sake.mk
index 6163ed2..59daa07 100644
--- a/lineage_sake.mk
+++ b/infinity_sake.mk
@@ -11,14 +11,25 @@ $(call inherit-product, $(SRC_TARGET_DIR)/product/full_base_telephony.mk)
 # Inherit from the device configuration.
 $(call inherit-product, device/asus/sake/device.mk)
 
-# Inherit from the Lineage configuration.
-$(call inherit-product, vendor/lineage/config/common_full_phone.mk)
+# Project Infinity X flags (must be set before inheriting vendor/infinity)
+INFINITY_MAINTAINER := James
+WITH_GAPPS := false
+TARGET_HAS_UDFPS := true
+
+# Inherit from the Project Infinity X configuration.
+$(call inherit-product, vendor/infinity/config/common_full_phone.mk)
 
 PRODUCT_BRAND := asus
 PRODUCT_DEVICE := sake
 PRODUCT_MANUFACTURER := asus
 PRODUCT_MODEL := ASUS_I006D
-PRODUCT_NAME := lineage_sake
+PRODUCT_NAME := infinity_sake
+
+# Project Infinity X "About phone" info
+PRODUCT_SYSTEM_PROPERTIES += \
+    ro.product.marketname=Zenfone 8 \
+    ro.infinity.soc=Snapdragon 888 \
+    ro.infinity.camera=64MP + 12MP
 
 PRODUCT_GMS_CLIENTID_BASE := android-asus
 
-- 
2.43.0

