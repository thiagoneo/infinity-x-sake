<?xml version="1.0" encoding="UTF-8"?>
<!-- Modelo: o scripts/sync.sh gera .repo/local_manifests/sake.xml trocando @GITHUB_USER@ e @TREE_BRANCH@ pelos valores do config.sh -->
<manifest>
  <remote name="gh" fetch="https://github.com" />

  <!-- Árvore do aparelho: o SEU fork, com os commits do Infinity X -->
  <project path="device/asus/sake"
           name="@GITHUB_USER@/android_device_asus_sake"
           remote="gh" revision="@TREE_BRANCH@" />

  <!-- Kernel (LineageOS) -->
  <project path="kernel/asus/sm8350"
           name="LineageOS/android_kernel_asus_sm8350"
           remote="gh" revision="lineage-24.0" />


  <!-- Blobs proprietários -->
  <project path="vendor/asus/sake"
           name="TheMuppets/proprietary_vendor_asus_sake"
           remote="gh" revision="lineage-24.0" />
</manifest>
